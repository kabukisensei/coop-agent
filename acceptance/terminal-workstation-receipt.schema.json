  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE",
        "NOT_REACHED",
        "NOT_AVAILABLE",
        "CAPABILITY_SKIP",
        "BETA_LIMITATION"
      ]
    },
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_sha",
        "observed_sha",
        "expected_version",
        "observed_version",
        "expected_build",
        "observed_build"
      ],
      "properties": {
        "expected_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "expected_build": {
          "type": "string",
          "pattern": "^build-[0-9a-f]{8}$"
        },
        "observed_build": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^build-[0-9a-f]{8}$"
            }
          ]
        }
      }
    },
    "baselineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_sha",
        "observed_sha",
        "expected_version",
        "observed_version"
      ],
      "properties": {
        "expected_sha": {
          "const": "d60300780b565aabf15b172b2bc32abad12b9ca6"
        },
        "observed_sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "harnessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_sha",
        "observed_version"
      ],
      "properties": {
        "observed_sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        },
        "observed_version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observed",
        "command",
        "exit_code",
        "identity",
        "path",
        "sha256",
        "warehouse_live"
      ],
      "properties": {
        "kind": {
          "enum": [
            "COMMAND",
            "HASH",
            "FILE",
            "OPERATOR_OBSERVATION"
          ]
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "identity": {
          "type": "string",
          "pattern": "^(harness|candidate|baseline|operator)(:[0-9a-f]{40})?$"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "warehouse_live": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/warehouseLiveEvidence"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "COMMAND"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "status",
        "required",
        "automated",
        "human_required",
        "summary",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "phase": {
          "enum": [
            "PRECHECK",
            "BASELINE",
            "UPGRADE",
            "REINSTALL",
            "ROLLBACK",
            "SECURITY",
            "OPERATOR"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "required": {
          "type": "boolean"
        },
        "automated": {
          "type": "boolean"
        },
        "human_required": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "automatedClaim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "automated": {
              "const": true
            },
            "human_required": {
              "const": false
            },
            "phase": {
              "not": {
                "const": "OPERATOR"
              }
            },
            "id": {
              "enum": [
                "identity-and-isolation",
                "baseline-source-install",
                "candidate-upgrade-preservation",
                "candidate-health-and-tools",
                "same-candidate-reinstall",
                "baseline-rollback-preservation",
                "sanitized-read-only-evidence",
                "automated-harness-completion"
              ]
            }
          },
          "type": "object"
        }
      ]
    },
    "operatorClaim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "phase": {
              "const": "OPERATOR"
            },
            "automated": {
              "const": false
            },
            "human_required": {
              "const": true
            },
            "id": {
              "enum": [
                "fresh-candidate-install",
                "real-provider-auth",
                "real-model-response",
                "copied-repo-workflow",
                "decline-no-partial-write",
                "stop-and-continue",
                "reopen-resume",
                "teamai-failure-isolation",
                "rollback-instructions",
                "warehouse-mcp-live-acceptance",
                "snapshot-recovery"
              ]
            }
          },
          "type": "object"
        }
      ]
    },
    "warehouseLiveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_state",
        "target_validation",
        "target_scope",
        "discovered_tool",
        "provenance",
        "mock"
      ],
      "properties": {
        "auth_state": {
          "const": "authenticated"
        },
        "target_validation": {
          "const": "validated"
        },
        "target_scope": {
          "const": "item"
        },
        "discovered_tool": {
          "enum": [
            "executeSQL",
            "execute_query",
            "fabric-sqlendpoint-execute_query",
            "fabric_sqlendpoint_execute_query"
          ]
        },
        "provenance": {
          "const": "live"
        },
        "mock": {
          "const": false
        }
      }
    }
  }
