{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coop.local/schemas/managed-runtime-build-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodeVersion", "pythonVersion", "pythonBuildRelease", "requiredPythonCommands", "sources", "pythonSources", "targetExclusions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "pythonVersion": { "type": "string", "pattern": "^3\\.12\\.[0-9]+$" },
    "pythonBuildRelease": { "type": "string", "pattern": "^[0-9]{8}$" },
    "requiredPythonCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["darwin-arm64", "darwin-x64", "win32-x64"],
      "properties": {
        "darwin-arm64": { "$ref": "#/$defs/source" },
        "darwin-x64": { "$ref": "#/$defs/source" },
        "win32-x64": { "$ref": "#/$defs/source" }
      }
    },
    "pythonSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["darwin-arm64", "darwin-x64", "win32-x64"],
      "properties": {
        "darwin-arm64": { "$ref": "#/$defs/pythonSource" },
        "darwin-x64": { "$ref": "#/$defs/pythonSource" },
        "win32-x64": { "$ref": "#/$defs/pythonSource" }
      }
    },
    "targetExclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["darwin-arm64", "darwin-x64", "win32-x64"],
      "properties": {
        "darwin-arm64": { "$ref": "#/$defs/exclusions" },
        "darwin-x64": { "$ref": "#/$defs/exclusions" },
        "win32-x64": { "$ref": "#/$defs/exclusions" }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "sha256", "archive", "root"],
      "properties": {
        "file": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://nodejs\\.org/download/release/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archive": { "enum": ["tar.gz", "zip"] },
        "root": { "type": "string" }
      }
    },
    "pythonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "url", "sha256", "archive", "root"],
      "properties": {
        "file": { "type": "string", "pattern": "^cpython-3\\.12\\.[0-9]+\\+[0-9]{8}-" },
        "url": { "type": "string", "pattern": "^https://github\\.com/astral-sh/python-build-standalone/releases/download/" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archive": { "const": "tar.gz" },
        "root": { "const": "python" }
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
