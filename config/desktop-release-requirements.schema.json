{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coop.local/schemas/desktop-release-requirements-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceMaxAgeHours", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceMaxAgeHours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "platforms"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "kind": { "enum": ["test-suite", "journey", "manual-interoperability", "distribution", "quality"] },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["windows", "macos"] }
          }
        }
      }
    }
  }
}
