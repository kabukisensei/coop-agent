{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cooptimize.local/schemas/standards-registry-v1.json",
  "title": "Cooptimize formal standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "domains"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": { "$ref": "#/$defs/domain" },
        "dax": { "$ref": "#/$defs/domain" },
        "semantic_model": { "$ref": "#/$defs/domain" },
        "fabric": { "$ref": "#/$defs/domain" },
        "documentation": { "$ref": "#/$defs/domain" }
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
