{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coop.local/schemas/knowledge-record.v1.json",
  "title": "Coop governed knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "title", "kind", "scope", "sensitivity",
    "status", "confidence", "tags", "appliesTo", "source", "createdAt",
    "createdBy", "review", "project", "sanitization", "supersedes",
    "supersededBy", "body"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^knowledge\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "kind": { "enum": ["pattern", "antipattern", "decision", "runbook", "troubleshooting", "standard", "exception"] },
    "scope": { "enum": ["project", "team"] },
    "sensitivity": { "enum": ["client-confidential", "internal"] },
    "status": { "enum": ["proposed", "approved", "rejected", "deprecated", "superseded"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "tags": { "$ref": "#/$defs/stringArray" },
    "appliesTo": { "$ref": "#/$defs/stringArray" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "references"],
      "properties": {
        "type": { "enum": ["human-authored", "reviewed-incident", "implementation", "review", "finding", "external-source"] },
        "references": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "createdBy": { "$ref": "#/$defs/identity" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAt", "reviewedBy"],
      "properties": {
        "reviewedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "reviewedBy": { "$ref": "#/$defs/nullableIdentity" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "projectId"],
      "properties": {
        "organizationId": { "$ref": "#/$defs/nullableIdentity" },
        "projectId": { "$ref": "#/$defs/nullableIdentity" }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientData", "checkedAt", "checkedBy"],
      "properties": {
        "clientData": { "enum": ["none", "present"] },
        "checkedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "checkedBy": { "$ref": "#/$defs/nullableIdentity" }
      }
    },
    "supersedes": { "$ref": "#/$defs/nullableKnowledgeId" },
    "supersededBy": { "$ref": "#/$defs/nullableKnowledgeId" },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "problem", "why", "approvedPattern", "antiPattern", "detection", "example", "exceptions", "sources"],
      "properties": {
        "context": { "$ref": "#/$defs/bodySection" },
        "problem": { "$ref": "#/$defs/bodySection" },
        "why": { "$ref": "#/$defs/bodySection" },
        "approvedPattern": { "$ref": "#/$defs/bodySection" },
        "antiPattern": { "$ref": "#/$defs/bodySection" },
        "detection": { "$ref": "#/$defs/bodySection" },
        "example": { "$ref": "#/$defs/bodySection" },
        "exceptions": { "$ref": "#/$defs/bodySection" },
        "sources": { "$ref": "#/$defs/bodySection" }
      }
    }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
    "nullableIdentity": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "nullableKnowledgeId": { "type": ["string", "null"], "pattern": "^knowledge\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "uniqueItems": true
    },
    "bodySection": { "type": "string", "minLength": 1, "maxLength": 32768 }
  }
}
