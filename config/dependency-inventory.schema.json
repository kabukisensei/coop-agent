{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coop.local/schemas/dependency-inventory-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "npm", "python"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "type": "object", "additionalProperties": false, "required": ["platform", "arch"], "properties": { "platform": { "enum": ["darwin", "win32"] }, "arch": { "enum": ["arm64", "x64"] } } },
    "npm": {
      "type": "object", "additionalProperties": false, "required": ["lockfileVersion", "completeIntegrity", "packages"],
      "properties": {
        "lockfileVersion": { "const": 3 }, "completeIntegrity": { "type": "boolean" },
        "packages": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "name", "version", "resolved", "integrity"], "properties": { "path": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" }, "resolved": { "type": "string", "pattern": "^https://" }, "integrity": { "type": ["string", "null"] } } } }
      }
    },
    "python": {
      "type": "object", "additionalProperties": false, "required": ["tools"],
      "properties": { "tools": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "distributions"], "properties": { "developmentSource": {"type":"object","additionalProperties":false,"required":["name","version","file","sha256","repository","revision"],"properties":{"name":{"enum":["coop-data-doc","coop-sql-review","coop-dax-review"]},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"file":{"type":"string","pattern":"^coop_[a-z_]+-[0-9]+\\.[0-9]+\\.[0-9]+-py3-none-any\\.whl$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"repository":{"type":"string","pattern":"^https://github\\.com/kabukisensei/coop-(data-doc|sql-review|dax-review)\\.git$"},"revision":{"type":"string","pattern":"^[a-f0-9]{40}$"}}}, "name": { "type": "string" }, "distributions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "version", "metadata"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "metadata": { "type": "string" } } } } } } }
      }
    }
  }
}
