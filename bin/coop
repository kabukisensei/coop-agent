#!/usr/bin/env bash
#
# coop — the Cooptimize terminal agent (Git Bash forwarder).
#
# coop is implemented once, in PowerShell: bin/coop.ps1 (dispatcher) and
# lib/common.ps1 (shared helpers), launched on Windows by bin/coop.cmd. This file
# keeps `coop` working from Git Bash (a supported Windows entry) and from a
# developer's pwsh on macOS/Linux by forwarding every argument to coop.ps1.
# It carries no product logic of its own (master plan S1: one Windows
# implementation). The one maintainer command that still runs in bash is
# `coop release` (scripts/release.sh), which needs the repo's bash test runner.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
COOP_ROOT="$(cd -P "$(dirname "$_src")/.." >/dev/null 2>&1 && pwd)"
export COOP_ROOT

case "${1:-}" in
  release) shift; exec bash "$COOP_ROOT/scripts/release.sh" "$@" ;;
esac

ps1="$COOP_ROOT/bin/coop.ps1"
[ -f "$ps1" ] || { printf 'coop: %s is missing — reinstall coop (git pull in the checkout, or coop install).\n' "$ps1" >&2; exit 1; }
# Git Bash hands MSYS paths to native programs unchanged; PowerShell wants C:\...
if command -v cygpath >/dev/null 2>&1; then ps1="$(cygpath -w "$ps1")"; fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$@"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$@"
elif command -v powershell >/dev/null 2>&1; then
  exec powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$ps1" "$@"
fi
printf 'coop: PowerShell not found. coop runs on Windows (PowerShell 5.1 or 7, see docs/install-windows.md); on macOS/Linux install PowerShell 7 (pwsh) to develop coop-agent.\n' >&2
exit 127
